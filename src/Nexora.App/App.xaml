<Application x:Class="Nexora.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#F6F7F9"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Border" Color="#E3E6EB"/>
    <SolidColorBrush x:Key="Text" Color="#1B1F27"/>
    <SolidColorBrush x:Key="Muted" Color="#5E6673"/>
    <SolidColorBrush x:Key="Accent" Color="#0F766E"/>
    <SolidColorBrush x:Key="NavBg" Color="#111827"/>
    <SolidColorBrush x:Key="NavText" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="NavSelected" Color="#1F2937"/>
    <SolidColorBrush x:Key="Warn" Color="#B45309"/>
    <SolidColorBrush x:Key="WarnBg" Color="#FEF3C7"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Application.Resources>
</Application>
