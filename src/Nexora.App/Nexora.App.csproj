<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>Nexora</AssemblyName>
    <RootNamespace>Nexora.App</RootNamespace>
    <!-- asInvoker: обычный просмотр не требует администратора -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexora.Core\Nexora.Core.csproj" />
    <ProjectReference Include="..\Nexora.Platform\Nexora.Platform.csproj" />
  </ItemGroup>
</Project>
