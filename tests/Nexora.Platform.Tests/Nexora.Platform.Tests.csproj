<Project Sdk="Microsoft.NET.Sdk">
  <!-- Интеграционные тесты на реальной системе: только чтение. Проверяют, что сбор не падает и
       каждое поле — либо значение, либо «недоступно» с причиной. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Nexora.Platform\Nexora.Platform.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Nexora.Core" />
  </ItemGroup>
</Project>
